/// A navigation item in the app drawer. Supports parent-child hierarchy,
/// drag-and-drop reorder, group-security gating, and dynamic route linking.
model NavigationItem {
  id             String           @id() @default(cuid())
  /// Parent nav item for nested hierarchy (null = root-level).
  parentId       String?          @map("parent_id")
  parent         NavigationItem?  @relation("NavChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children       NavigationItem[] @relation("NavChildren")
  sortOrder      Int              @default(0) @map("sort_order")
  title          String
  /// Route path e.g. "/dashboard", "/admin", "/sheet-profit-loss". External URLs also supported.
  path           String           @default("")
  /// MUI icon name (optional).
  icon           String           @default("")
  /// Auth tier required to see this nav item.
  authTier       AuthTier         @default(public) @map("auth_tier")
  /// Tenant slug for multi-tenant isolation.
  tenantSlug     String?          @map("tenant_slug")
  /// Suite-mode app id, when this item is scoped to a single app within a tenant.
  appId          String?          @map("app_id")
  /// When false the item is treated as inactive/disabled (different from isVisible).
  isActive       Boolean          @default(true) @map("is_active")
  /// Comma-separated security group codes. Empty means no group restriction.
  requiredGroups String           @default("") @map("required_groups")
  /// When false the item is hidden from the nav but still exists in the tree.
  isVisible      Boolean          @default(true) @map("is_visible")
  /// When true the path is treated as a dynamic /[slug] route rather than static.
  isDynamic      Boolean          @default(false) @map("is_dynamic")
  /// When true this item is the configured default landing route for root visits.
  isDefault      Boolean          @default(false) @map("is_default")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt() @map("updated_at")

  @@index([parentId, sortOrder])
  @@index([tenantSlug], map: "idx_navigation_items_tenant_slug")
  @@index([tenantSlug, appId], map: "idx_navigation_items_tenant_app")
  @@map("navigation_items")
}

