  @@index([appId], map: "idx_monthly_actual_inputs_app_id")
  @@map("monthly_actual_inputs")
}

model MonthlyActualDepartment {
  period        String
  department    String
  inputs        Json     @default("{}")
  receiptImages Json     @default("[]") @map("receipt_images")
  notes         String   @default("")
  updatedAt     DateTime @updatedAt() @map("updated_at")
  /// Suite-mode app id — empty string means the tenant's own (single-app) copy.
  appId         String   @default("") @map("app_id")

  @@id([period, department, appId])
  @@index([appId], map: "idx_monthly_actual_departments_app_id")
  @@map("monthly_actual_departments")
}

