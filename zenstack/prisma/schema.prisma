/// A registered tenant application — created via the root config app wizard.
model Tenant {
  id              String          @id() @default(cuid())
  /// Subdomain slug — unique identifier (e.g. "redrubybali")
  slug            String          @unique()
  /// Human-readable business name (e.g. "Red Ruby Bali")
  displayName     String          @map("display_name")
  /// Template category (e.g. "nightclub-bar", "restaurant", "hotel")
  template        String          @default("default")
  /// Status: "draft" | "deploying" | "live" | "error"
  status          String          @default("draft")
  /// Vercel project ID (populated after deploy)
  vercelProjectId String?         @map("vercel_project_id")
  /// Custom domain (e.g. "redrubybali.vercel.app")
  appUrl          String?         @map("app_url")
  /// Neon database URL for this tenant (if separate DB)
  dbUrl           String?         @map("db_url")
  /// License API key for programmatic access
  apiKey          String?         @map("api_key")
  /// Brand primary color (hex)
  primaryColor    String          @default("#eb3d28") @map("primary_color")
  /// Brand secondary color (hex)
  secondaryColor  String          @default("#0af9fe") @map("secondary_color")
  /// Base64-encoded favicon data (served via /api/favicon)
  faviconData     String?         @map("favicon_data")
  /// Favicon MIME type (e.g. "image/x-icon", "image/png")
  faviconMimeType String?         @default("image/x-icon") @map("favicon_mime_type")
  /// Arbitrary JSON metadata
  metadata        Json            @default("{}")
  /// Who created this tenant
  createdBy       String?         @map("created_by")
  /// Billing owner. Nullable so pre-existing tenants keep working until the
  /// backfill assigns them (see backfillDefaultOrganization).
  organizationId  String?         @map("organization_id")
  organization    Organization?   @relation(fields: [organizationId], references: [id])
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt() @map("updated_at")
  webhookConfigs  WebhookConfig[]

  @@index([organizationId], map: "idx_tenants_organization")
  @@map("tenants")
}

model WebhookConfig {
  id            String          @id() @default(cuid())
  tenantId      String?         @map("tenant_id")
  tenant        Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  provider      WebhookProvider @default(vercel)
  /// The public endpoint URL registered with Vercel
  endpointUrl   String          @map("endpoint_url")
  /// HMAC secret used for x-vercel-signature verification
  signingSecret String?         @map("signing_secret")
  description   String?
  isActive      Boolean         @default(true) @map("is_active")
  lastTriggered DateTime?       @map("last_triggered")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt() @map("updated_at")
  events        WebhookEvent[]

  @@map("webhook_configs")
}

model WebhookEvent {
  id           String        @id() @default(cuid())
  configId     String        @map("config_id")
  config       WebhookConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  eventType    String        @map("event_type")
  payload      Json
  status       String        @default("received")
  /// received | processed | failed | ignored
  errorMessage String?       @map("error_message")
  durationMs   Int?          @map("duration_ms")
  createdAt    DateTime      @default(now()) @map("created_at")
  processedAt  DateTime?     @map("processed_at")

  @@index([configId, eventType])
  @@index([status, createdAt])
  @@map("webhook_events")
}

model Organization {
  id                 String          @id() @default(cuid())
  /// URL-safe identifier, editable by the owner.
  slug               String          @unique()
  displayName        String          @map("display_name")
  logoUrl            String?         @map("logo_url")
  /// Background image URL for the tenant app.
  backgroundImageUrl String?         @map("background_image_url")
  /// Background video URL for the tenant app (autoplay, no sound).
  backgroundVideoUrl String?         @map("background_video_url")
  /// Custom CSS for the tenant app (stored as-is).
  customCss          String?         @map("custom_css")
  /// Account that owns billing for this organization.
  ownerUserId        String?         @map("owner_user_id")
  /// Affiliate attribution. Recorded at signup — impossible to backfill later.
  referredBy         String?         @map("referred_by")
  /// Where invoices go. Falls back to the owner's account email when unset.
  billingEmail       String?         @map("billing_email")
  /// Legal entity name, when it differs from displayName.
  billingName        String?         @map("billing_name")
  /// ISO 3166-1 alpha-2. Drives nothing today; recorded for the invoice.
  billingCountry     String?         @map("billing_country")
  billingLine1       String?         @map("billing_line1")
  billingLine2       String?         @map("billing_line2")
  billingCity        String?         @map("billing_city")
  billingPostal      String?         @map("billing_postal")
  /// VAT/GST/NPWP number, printed on invoices. NOT a tax calculation input —
  /// Stripe Tax is off, so nothing here changes what is charged.
  taxId              String?         @map("tax_id")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt() @map("updated_at")
  members            OrgMember[]
  tenants            Tenant[]
  subscription       Subscription?
  creditGrants       CreditGrant[]
  creditLedger       CreditLedger[]
  /// Where this organization came from. Written once, at signup.
  orgAttribution     OrgAttribution?

  @@map("organizations")
}

/// User profile extensions — data not from the auth provider.
///
/// The auth provider (Google) owns name, email, and picture. This table
/// extends that with user-managed fields like a custom avatar.
model UserProfile {
  id        String   @id() @default(cuid())
  /// Email from the auth provider, used as the stable identifier.
  userEmail String   @unique() @map("user_email")
  /// Custom avatar URL or base64 data URI. Overrides the auth provider picture.
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt() @map("updated_at")

  @@map("user_profiles")
}

/// Marketing channel an organization arrived through, captured at signup.
///
/// Distinct from `Organization.referredBy`, which names the affiliate who gets
/// paid; this is *how* they found the product, and it only exists for as long
/// as the signup request does — there is no backfilling it later.
///
/// One row per organization. `orgId` is unique because the service upserts with
/// `ON CONFLICT (org_id)`, which needs a constraint to land on; without it
/// Postgres rejects the statement outright (42P10).
model OrgAttribution {
  id           String       @id() @default(cuid())
  orgId        String       @unique() @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel      String
  capturedAt   DateTime     @default(now()) @map("captured_at")

  @@map("org_attribution")
}

/// One metered quantity, for one tenant, for one period.
///
/// Idempotent on (tenantSlug, resource, periodStart): re-running a collector
/// over a period it already covered must correct the number, never add a second
/// row, or a retried job silently doubles the bill.
///
/// Quantity is deliberately untyped as to unit — a resource is invocations, or
/// GB-hours, or GB, and forcing one unit across all of them would mean storing
/// a lie for most. `unit` records which it is.
model UsageRecord {
  id          String   @id() @default(cuid())
  orgId       String   @map("org_id")
  tenantSlug  String   @map("tenant_slug")
  /// Suite-mode app id, when the usage is attributable to one app.
  appId       String?  @map("app_id")
  /// function_invocations | function_duration | bandwidth | db_storage | db_compute | build_cpu_minutes
  resource    String
  /// invocations | gb_hours | gb | requests | cu_hours | minutes
  unit        String   @default("units")
  quantity    Float    @default(0)
  /// Billed cost in cents, when the provider reports it (Vercel FOCUS).
  /// Null where no cost applies (Neon Free plan) — the rate card covers those.
  costCents   Int?     @map("cost_cents")
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  recordedAt  DateTime @default(now()) @map("recorded_at")

  @@unique([tenantSlug, appId, resource, periodStart], map: "usage_records_tenant_app_resource_period_key")
  @@index([orgId, periodStart], map: "idx_usage_records_org_period")
  @@map("usage_records")
}

/// Run-time spend balance for an organization, in cents.
///
/// May go negative, deliberately: cutting an app off mid-month over a few cents
/// is worse for both sides than carrying a small debt to the next invoice.
model CloudBalance {
  id                 String   @id() @default(cuid())
  orgId              String   @unique() @map("org_id")
  balanceCents       Int      @default(0) @map("balance_cents")
  /// Auto top-up trigger, in cents. Null means auto top-up is off.
  autoTopUpThreshold Int?     @map("auto_top_up_threshold")
  autoTopUpAmount    Int?     @map("auto_top_up_amount")
  updatedAt          DateTime @updatedAt() @map("updated_at")

  @@map("cloud_balances")
}

model OrgMember {
  id           String       @id() @default(cuid())
  orgId        String       @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId       String       @map("user_id")
  /// owner | admin | member | billing
  role         String       @default("member")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@unique([orgId, userId])
  @@index([userId])
  @@map("org_members")
}

model Subscription {
  id                   String       @id() @default(cuid())
  orgId                String       @unique() @map("org_id")
  organization         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// free | pro | business | enterprise — see src/lib/billing/plans.ts
  planId               String       @default("free") @map("plan_id")
  /// active | past_due | canceled | trialing
  status               String       @default("active")
  /// monthly | yearly
  interval             String       @default("monthly")
  currentPeriodStart   DateTime     @default(now()) @map("current_period_start")
  currentPeriodEnd     DateTime     @map("current_period_end")
  cancelAtPeriodEnd    Boolean      @default(false) @map("cancel_at_period_end")
  /// Billing anchor. Held separately from currentPeriodStart so an upgrade
  /// mid-cycle does not reset the cycle and hand out a free extension.
  anchorDate           DateTime     @default(now()) @map("anchor_date")
  /// ── Stripe linkage (Phase 4) ──
  /// Stripe customer for this org. Also carries orgId in its own metadata so
  /// the mapping survives loss of this row.
  stripeCustomerId     String?      @map("stripe_customer_id")
  stripeSubscriptionId String?      @map("stripe_subscription_id")
  /// The price Stripe is actually billing — authoritative over planId when the
  /// two disagree, since the price is what the customer is charged.
  stripePriceId        String?      @map("stripe_price_id")
  /// Dunning: when the 7-day grace period after a failed payment lapses. Null
  /// when billing is healthy.
  gracePeriodEndsAt    DateTime?    @map("grace_period_ends_at")
  /// Plan this org drops to at the next period boundary (scheduled downgrade).
  pendingPlanId        String?      @map("pending_plan_id")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt() @map("updated_at")

  @@index([planId, status])
  @@index([stripeCustomerId], map: "idx_subscriptions_stripe_customer")
  @@index([stripeSubscriptionId], map: "idx_subscriptions_stripe_subscription")
  @@map("subscriptions")
}

/// Stripe webhook delivery log — the idempotency ledger.
///
/// The primary key IS the Stripe event id: processing claims the row with an
/// INSERT, so a concurrent retry loses the race and skips the work rather than
/// granting the same credits twice. Never truncate this table casually — doing
/// so re-opens every historical event to reprocessing.
model StripeEvent {
  /// Stripe's event id (evt_…), not a generated one.
  id           String    @id()
  type         String
  /// Resolved org, when the event carried enough to identify one.
  orgId        String?   @map("org_id")
  /// processing | processed | failed | ignored
  status       String    @default("processing")
  errorMessage String?   @map("error_message")
  receivedAt   DateTime  @default(now()) @map("received_at")
  processedAt  DateTime? @map("processed_at")

  @@index([type, receivedAt], map: "idx_stripe_events_type_received")
  @@map("stripe_events")
}

model CreditGrant {
  id           String       @id() @default(cuid())
  orgId        String       @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// plan = monthly allowance, addon = purchased top-up, onetime = negotiated
  /// volume deal, promo = promotional bonus — kept separate so promo generosity
  /// is measurable and withdrawable without touching purchased credits.
  source       String
  /// Total credits granted.
  amount       Int
  /// Credits not yet consumed.
  remaining    Int
  grantedAt    DateTime     @default(now()) @map("granted_at")
  /// Grants expire 30 days after issue.
  expiresAt    DateTime     @map("expires_at")
  /// Which plan the grant came from (for plan-source grants).
  planId       String?      @map("plan_id")
  /// Free-form (e.g. stripe session id, promo code).
  metadata     Json?

  @@index([orgId, expiresAt], map: "idx_credit_grants_org_expires")
  @@map("credit_grants")
}

model CreditLedger {
  id           String       @id() @default(cuid())
  orgId        String       @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// The grant this entry debits/credits (null for balance-level entries).
  grantId      String?      @map("grant_id")
  /// Positive = grant, negative = consumption.
  delta        Int
  /// plan_allowance | topup_purchase | ai_generation | promo_bonus | admin_adjustment
  reason       String
  /// content_generation | chat | app_pack | schema_generation
  refType      String?      @map("ref_type")
  /// Optional reference id.
  refId        String?      @map("ref_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  metadata     Json?

  @@index([orgId, createdAt], map: "idx_credit_ledger_org_created")
  @@map("credit_ledger")
}

/// AI-generated app template, stored in the platform root DB.
/// Built-in templates live in code (src/domain/tenant/template-catalog.ts);
/// these are created by an administrator via the chat assistant's
/// "Custom Template Build" tool and appear alongside the built-ins in every
/// template picker. Control-plane config — never created in a tenant DB.
model CustomTemplate {
  id           String   @id()
  label        String
  description  String   @default("")
  icon         String   @default("Dashboard")
  /// single | suite
  templateType String   @default("single") @map("template_type")
  /// Full TemplateDefinition payload (pages, nav, colours, schema.org type).
  definition   Json     @default("{}")
  /// Optional capabilities, e.g. the Web3 social wallet config.
  capabilities Json     @default("{}")
  /// url | knowledge | prompt — how the template was produced.
  sourceKind   String   @default("prompt") @map("source_kind")
  sourceRef    String?  @map("source_ref")
  prompt       String?
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt() @map("updated_at")

  @@map("custom_templates")
}
