/// A role/owner of tasks — a display-name catalog (code + name).
/// Roles are NOT tied to a person: people map to roles via the PERSONS
/// registry (person.roleCode), and group/route security uses SecurityGroup
/// memberships, never this table.
model Role {
  id              String           @id() @default(cuid())
  /// Short code used to match task labels, e.g. "Ama", "Made", "Lukas", "James", "Graham".
  code            String           @unique() @map("code")
  /// Display name shown in task views and the Admin UI.
  name            String
  isPlatformAdmin Boolean          @default(false) @map("is_platform_admin")
  /// Tenant slug for multi-tenant isolation (tenant-scoped roles are code-prefixed "{tenantSlug}:{code}").
  tenantSlug      String?          @map("tenant_slug")
  /// Suite-mode app id, when this role is scoped to a single app within a tenant.
  appId           String?          @map("app_id")
  tasks           TaskAssignment[]
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([tenantSlug, appId], map: "idx_roles_tenant_app")
  @@map("roles")
}

/// A signed-in user account (keyed by the auth provider subject / sub).
model UserAccount {
  id              String               @id() @default(cuid())
  sub             String               @unique() @map("sub")
  email           String?              @map("email")
  name            String?              @map("name")
  tier            String               @default("google") @map("tier")
  roleCode        String?              @map("role_code")
  /// Tenant slug for multi-tenant isolation.
  tenantSlug      String?              @map("tenant_slug")
  /// Suite-mode app id, when this account is scoped to a single app within a tenant.
  appId           String?              @map("app_id")
  isActive        Boolean              @default(true) @map("is_active")
  lastSeenAt      DateTime?            @map("last_seen_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt() @map("updated_at")
  groups          UserGroup[]
  taskAssignments TaskUserAssignment[]

  @@index([tenantSlug], map: "idx_user_accounts_tenant_slug")
  @@index([tenantSlug, appId], map: "idx_user_accounts_tenant_app")
  @@map("user_accounts")
}

/// A security group used to gate API calls and routes by membership.
model SecurityGroup {
  id          String      @id() @default(cuid())
  code        String      @unique() @map("code")
  name        String
  description String?     @map("description")
  isSystem    Boolean     @default(false) @map("is_system")
  /// Capability codes granted to members (e.g. "financials:write", "tasks:read").
  permissions String[]    @default([]) @map("permissions")
  /// Tenant slug for multi-tenant isolation (tenant-scoped groups are code-prefixed "{tenantSlug}:{code}").
  tenantSlug  String?     @map("tenant_slug")
  /// Suite-mode app id, when this group is scoped to a single app within a tenant.
  appId       String?     @map("app_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  members     UserGroup[]

  @@index([tenantSlug, appId], map: "idx_security_groups_tenant_app")
  @@map("security_groups")
}

/// Membership linking a user account to a security group.
model UserGroup {
  id        String        @id() @default(cuid())
  user      UserAccount   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String        @map("user_id")
  group     SecurityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String        @map("group_id")
  createdAt DateTime      @default(now()) @map("created_at")

  @@unique([userId, groupId])
  @@index([groupId], map: "idx_user_groups_group")
  @@index([userId], map: "idx_user_groups_user")
  @@map("user_groups")
}

/// A tracked action item derived from the MVP Business Review priority actions.
model Task {
  id              String               @id() @default(cuid())
  title           String
  /// Free-text detail / acceptance note.
  description     String?              @db.Text()
  priority        ActionPriority       @default(P0)
  status          TaskStatus           @default(pending)
  /// ISO date (YYYY-MM-DD) by which the task should be done.
  dueDate         DateTime?            @map("due_date")
  sortOrder       Int                  @default(0) @map("sort_order")
  assignments     TaskAssignment[]
  userAssignments TaskUserAssignment[]
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt() @map("updated_at")
  /// Suite-mode app id — empty string means the tenant's own (single-app) copy.
  appId           String               @default("") @map("app_id")

  @@index([status])
  @@index([appId], map: "idx_tasks_app_id")
  @@map("tasks")
}

/// Many-to-many link between a Task and the Roles responsible for it.
model TaskAssignment {
  id       String  @id() @default(cuid())
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId   String  @map("task_id")
  role     Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId   String  @map("role_id")
  /// When true the role's owner sees this on their personal daily checklist.
  assigned Boolean @default(true)

  @@unique([taskId, roleId])
  @@index([roleId], map: "task_assignments_role_id_idx")
  @@map("task_assignments")
}

/// Per-user task assignment: links a task to a specific user_accounts row so
/// signed-in users see admin-assigned tasks even without a role match.
model TaskUserAssignment {
  id       String      @id() @default(cuid())
  task     Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId   String      @map("task_id")
  user     UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String      @map("user_account_id")
  /// When true the user sees this on their personal task checklist.
  assigned Boolean     @default(true)

  @@unique([taskId, userId])
  @@index([userId], map: "task_user_assignments_user_account_id_idx")
  @@map("task_user_assignments")
}

