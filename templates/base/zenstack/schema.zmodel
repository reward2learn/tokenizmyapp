// Base Template — ZenStack schema (stripped)
// Contains only base models (auth, admin, chat, content, navigation, tasks, tenants)
// Template-specific models are added by the codegen service based on AI-generated schema.
// Introspection-first: @@map to existing Neon tables. No greenfield renames.
// Generate: npm run zen:generate (after P1 scaffold)
// Policies: auth tier from JWT user context (public | pin | google)

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

// ── Enums ────────────────────────────────────────────

enum AuthTier {
  public
  pin
  google
}

/// JWT session context passed to enhance({ user }) — not a DB table
type Auth {
  id   String    @id @default("session")
  tier AuthTier
  sub  String?

  @@auth
}

enum ActionPriority {
  P0
  P1
  P2
}

enum TaskStatus {
  pending
  in_progress
  submitted
  completed
}

enum BlockType {
  hero
  metric_grid

  action_checklist
  doc_markdown

  calendar_import
  chat_panel
  kpi_cards
  ops_admin_tabs

}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ── Content models (new tables — created via ZenStack migrate in P1) ──

model AppPage {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  authTier  AuthTier      @default(public) @map("auth_tier")
  sortOrder Int           @default(0) @map("sort_order")
  sections  PageSection[]

  @@map("app_pages")
}

model PageSection {
  id        String    @id @default(cuid())
  pageId    String    @map("page_id")
  page      AppPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sortOrder Int       @map("sort_order")
  blockType BlockType @map("block_type")
  config    Json      @default("{}")

  @@index([pageId, sortOrder])
  @@map("page_sections")
}

// ── Task tracking (role-based exit-viability action tracking) ──

/// A role/owner of tasks — Ama, Made, Lukas, James, Graham (platform-admin managed).
model Role {
  id          String           @id @default(cuid())
  /// Short code used to match task labels, e.g. "Ama", "Made", "Lukas", "James", "Graham".
  code        String           @unique @map("code")
  name        String
  /// Google email used to auto-assign the signed-in user to this role.
  email       String?          @unique @map("email")
  isPlatformAdmin Boolean       @default(false) @map("is_platform_admin")
  tasks       TaskAssignment[]
  createdAt   DateTime         @default(now()) @map("created_at")

  @@allow('read', true)
  @@allow('create,update,delete', auth().tier == pin || auth().tier == google)
  @@map("roles")
}

/// A signed-in user account (keyed by the auth provider subject / sub).
model UserAccount {
  id          String        @id @default(cuid())
  sub         String        @unique @map("sub")
  email       String?       @map("email")
  name        String?       @map("name")
  tier        String        @default("google") @map("tier")
  roleCode    String?       @map("role_code")
  isActive    Boolean       @default(true) @map("is_active")
  lastSeenAt  DateTime?     @map("last_seen_at")
  metadata    Json          @default("{}")
  avatarUrl   String?       @map("avatar_url")
  bio         String?       @db.Text
  phone       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  groups      UserGroup[]

  @@allow('read', auth().tier == pin || auth().tier == google)
  @@allow('update', auth().tier == pin || auth().tier == google)
  @@map("user_accounts")
}

/// A security group used to gate API calls and routes by membership.
model SecurityGroup {
  id          String      @id @default(cuid())
  code        String      @unique @map("code")
  name        String
  description String?     @map("description")
  isSystem    Boolean     @default(false) @map("is_system")
  /// Capability codes granted to members (e.g. "financials:write", "tasks:read").
  permissions String[]    @default([]) @map("permissions")
  createdAt   DateTime    @default(now()) @map("created_at")
  members     UserGroup[]

  @@allow('read', auth().tier == pin || auth().tier == google)
  @@allow('create,update,delete', auth().tier == pin || auth().tier == google)
  @@map("security_groups")
}

/// Membership linking a user account to a security group.
model UserGroup {
  id      String        @id @default(cuid())
  user    UserAccount   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String        @map("user_id")
  group   SecurityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String        @map("group_id")
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
  @@map("user_groups")
}

/// A tracked action item derived from the MVP Business Review priority actions.
model Task {
  id          String           @id @default(cuid())
  title       String
  /// Free-text detail / acceptance note.
  description String?          @db.Text
  priority    ActionPriority   @default(P0)
  status      TaskStatus       @default(pending)
  /// ISO date (YYYY-MM-DD) by which the task should be done.
  dueDate     DateTime?        @map("due_date")
  sortOrder   Int              @default(0) @map("sort_order")
  assignments TaskAssignment[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@allow('read', true)
  @@allow('create,update,delete', auth().tier == pin || auth().tier == google)
  @@map("tasks")
}

/// Many-to-many link between a Task and the Roles responsible for it.
model TaskAssignment {
  id          String   @id @default(cuid())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String   @map("task_id")
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId      String   @map("role_id")
  /// When true the role's owner sees this on their personal daily checklist.
  assigned    Boolean  @default(true)

  @@unique([taskId, roleId])
  @@index([roleId])
  @@allow('read', true)
  @@allow('create,update,delete', auth().tier == pin || auth().tier == google)
  @@map("task_assignments")
}

model KnowledgeSnippet {
  id       String @id @default(cuid())
  key      String @unique
  content  String @db.Text
  category String

  @@allow('read', true)
  @@allow('create,update,delete', auth().tier == pin || auth().tier == google)
  @@map("knowledge_snippets")
}

// ── Navigation (admin-managed, hierarchical, group-gated) ──

/// A navigation item in the app drawer. Supports parent-child hierarchy,
/// drag-and-drop reorder, group-security gating, and dynamic route linking.
model NavigationItem {
  id            String            @id @default(cuid())
  /// Parent nav item for nested hierarchy (null = root-level).
  parentId      String?           @map("parent_id")
  parent        NavigationItem?   @relation("NavChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children      NavigationItem[]  @relation("NavChildren")
  sortOrder     Int               @default(0) @map("sort_order")
  title         String
  /// Route path e.g. "/dashboard", "/admin", "/sheet-profit-loss". External URLs also supported.
  path          String            @default("")
  /// MUI icon name (optional).
  icon          String            @default("")
  /// Auth tier required to see this nav item.
  authTier      AuthTier          @default(public) @map("auth_tier")
  /// Comma-separated security group codes. Empty means no group restriction.
  requiredGroups String           @default("") @map("required_groups")
  /// When false the item is hidden from the nav but still exists in the tree.
  isVisible     Boolean           @default(true) @map("is_visible")
  /// When true the path is treated as a dynamic /[slug] route rather than static.
  isDynamic     Boolean           @default(false) @map("is_dynamic")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@allow('read', true)
  @@allow('create,update,delete', auth().tier == pin || auth().tier == google)
  @@index([parentId, sortOrder])
  @@map("navigation_items")
}

// ── Production tables (mapped from lib/db.js + schema.sql) ──

model Secret {
  keyName        String   @id @map("key_name")
  encryptedValue String   @map("encrypted_value")
  iv             String
  authTag        String   @map("auth_tag")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Server-side only (store-key, verify-pin) — never exposed to browser clients
  @@allow('all', true)
  @@map("secrets")
}

/// Singleton app settings — chat flags, brand config, tenant identity, etc.
model AppSetting {
  id                  String   @id @default("default")
  webSearchEnabled    Boolean  @default(false) @map("web_search_enabled")
  /// Tenant subdomain slug (e.g. "redrubybali" — used for URL derivation)
  tenantSlug          String   @default("tokenizmyapp") @map("tenant_slug")
  /// Human-readable business name (e.g. "Red Ruby Bali")
  tenantDisplayName   String   @default("") @map("tenant_display_name")
  /// Template category identifier (e.g. "nightclub-bar", "restaurant", "hotel")
  tenantTemplate      String   @default("default") @map("tenant_template")
  /// Arbitrary JSON metadata for tenant-specific configuration
  tenantMetadata      Json     @default("{}") @map("tenant_metadata")
  brandLogoText       String   @default("") @map("brand_logo_text")
  brandLogoUrl        String   @default("") @map("brand_logo_url")
  brandPrimaryColor   String   @default("#eb3d28") @map("brand_primary_color")
  brandSecondaryColor String   @default("#0af9fe") @map("brand_secondary_color")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@allow('all', true)
  @@map("app_settings")
}

/// Singleton Google OAuth credentials — client_secret encrypted at rest (AES-256-GCM).
model GoogleOAuthConfig {
  id              String   @id @default("default")
  clientId        String   @map("client_id")
  projectId       String   @map("project_id")
  authUri         String   @map("auth_uri")
  tokenUri        String   @default("https://oauth2.googleapis.com/token") @map("token_uri")
  encryptedSecret String   @map("encrypted_secret")
  iv              String
  authTag         String   @map("auth_tag")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Server-side only (OAuth redirect/callback) — client_secret never returned to frontend
  @@allow('all', true)
  @@map("google_oauth_config")
}

model Conversation {
  id           Int      @id @default(autoincrement())
  userName     String   @default("Anonymous") @map("user_name")
  ownerSub     String?  @map("owner_sub")
  title        String   @default("Chat Conversation")
  messages     Json     @default("[]")
  messageCount Int      @default(0) @map("message_count")
  archived     Boolean  @default(false) @map("archived")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Server-side only (/api/chat?resource=conversations) — session enforced in route handler
  @@allow('all', true)
  @@map("conversations")
}

/// Financial projections — preserve data_type + scenario (tri-review requirement)
/// Legacy — schema.sql only; ensure migration creates if missing (see website-db-migration ensureLegacyTables)
// ── Tenant registry (root config app) ──

/// A registered tenant application — created via the root config app wizard.
model Tenant {
  id              String   @id @default(cuid())
  /// Subdomain slug — unique identifier (e.g. "redrubybali")
  slug            String   @unique
  /// Human-readable business name (e.g. "Red Ruby Bali")
  displayName     String   @map("display_name")
  /// Template category (e.g. "nightclub-bar", "restaurant", "hotel")
  template        String   @default("default")
  /// Status: "draft" | "deploying" | "live" | "error"
  status          String   @default("draft")
  /// Vercel project ID (populated after deploy)
  vercelProjectId String?  @map("vercel_project_id")
  /// Custom domain (e.g. "redrubybali.vercel.app")
  appUrl          String?  @map("app_url")
  /// Neon database URL for this tenant (if separate DB)
  dbUrl           String?  @map("db_url")
  /// Brand primary color (hex)
  primaryColor    String   @default("#eb3d28") @map("primary_color")
  /// Brand secondary color (hex)
  secondaryColor  String   @default("#0af9fe") @map("secondary_color")
  /// Arbitrary JSON metadata
  metadata        Json     @default("{}")
  /// Who created this tenant
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@allow('read', true)
  @@allow('create,update,delete', auth().tier == pin || auth().tier == google)
  @@map("tenants")
}

// ── Access policies (ZenStack — enforce in P1 generate) ──
// Financial writes: auth().tier == pin || auth().tier == google
// Review parts: auth().tier == google
// Public read: metrics list, legal pages

// ── Phase 10B: Content Pages (Legal CRUD) ──────────────────────

model ContentPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  body        String   @db.Text
  format      String   @default("html")
  isPublished Boolean  @default(true) @map("is_published")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@allow('read', true)
  @@allow('create,update,delete', auth().tier == pin || auth().tier == google)
  @@map("content_pages")
}

// ── Phase 10C: Media Assets (Image + Video upload) ─────────────

model MediaAsset {
  id           String   @id @default(cuid())
  uploadedBy   String   @map("uploaded_by")
  filename     String
  mimeType     String   @map("mime_type")
  size         Int
  storage      String   @default("vercel-blob")
  url          String
  thumbnailUrl String?  @map("thumbnail_url")
  altText      String?  @map("alt_text")
  width        Int?
  height       Int?
  duration     Float?
  tags         String[] @default([])
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([uploadedBy])
  @@index([mimeType])
  @@allow('read', true)
  @@allow('create,update,delete', auth().tier == pin || auth().tier == google)
  @@map("media_assets")
}

// ── Phase 10D: Notifications ───────────────────────────────────

model Notification {
  id           String   @id @default(cuid())
  userSub      String   @map("user_sub")
  type         String   @default("info")
  title        String
  body         String   @db.Text
  linkUrl      String?  @map("link_url")
  isRead       Boolean  @default(false) @map("is_read")
  isDismissed  Boolean  @default(false) @map("is_dismissed")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userSub, isRead])
  @@allow('read', auth().sub == userSub)
  @@allow('update', auth().sub == userSub)
  @@allow('create,delete', auth().tier == pin || auth().tier == google)
  @@map("notifications")
}

// ── Phase 10G: Commerce (Products, Orders, Bookings) ───────────

model Product {
  id              String   @id @default(cuid())
  type            String   @default("product")
  name            String
  slug            String   @unique
  summary         String   @db.Text
  description     String   @db.Text
  price           Int
  currency        String   @default("USD")
  compareAtPrice  Int?     @map("compare_at_price")
  sku             String?
  category        String?
  tags            String[] @default([])
  imageUrl        String?  @map("image_url")
  galleryUrls     String[] @default([]) @map("gallery_urls")
  videoUrl        String?  @map("video_url")
  stockCount      Int?     @map("stock_count")
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  seoTitle        String?  @map("seo_title")
  seoDescription  String?  @db.Text @map("seo_description")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  bookings        Booking[]

  @@index([category, isActive])
  @@index([type])
  @@allow('read', true)
  @@allow('create,update,delete', auth().tier == pin || auth().tier == google)
  @@map("products")
}

model Order {
  id               String   @id @default(cuid())
  orderNumber      String   @unique @map("order_number")
  customerEmail    String   @map("customer_email")
  customerName     String   @map("customer_name")
  customerPhone    String?  @map("customer_phone")
  customerSub      String?  @map("customer_sub")
  items            Json
  subtotal         Int
  tax              Int      @default(0)
  shipping         Int      @default(0)
  discount         Int      @default(0)
  total            Int
  currency         String   @default("USD")
  paymentStatus    String   @default("pending") @map("payment_status")
  paymentMethod    String?  @map("payment_method")
  paymentTxId      String?  @map("payment_tx_id")
  fulfillmentStatus String  @default("pending") @map("fulfillment_status")
  shippingAddress  Json?    @map("shipping_address")
  bookingDetails   Json?    @map("booking_details")
  notes            String?  @db.Text
  campaignData     Json?    @map("campaign_data")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([customerEmail])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@allow('read', auth().sub == customerSub || auth().tier == pin || auth().tier == google)
  @@allow('create', true)
  @@allow('update', auth().tier == pin || auth().tier == google)
  @@map("orders")
}

model Booking {
  id            String   @id @default(cuid())
  reference     String   @unique
  customerEmail String   @map("customer_email")
  customerName  String   @map("customer_name")
  customerPhone String?  @map("customer_phone")
  customerSub   String?  @map("customer_sub")
  productId     String   @map("product_id")
  product       Product  @relation(fields: [productId], references: [id])
  date          DateTime
  startTime     String   @map("start_time")
  duration      Int      @default(60)
  partySize     Int      @default(1) @map("party_size")
  status        String   @default("pending")
  notes         String?  @db.Text
  orderId       String?  @map("order_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([productId, date])
  @@index([customerEmail])
  @@index([status])
  @@allow('read', auth().sub == customerSub || auth().tier == pin || auth().tier == google)
  @@allow('create', true)
  @@allow('update', auth().tier == pin || auth().tier == google)
  @@map("bookings")
}

// ── Phase 10H: Marketing (Blog, Subscribers, Leads, Campaigns) ─

model BlogPost {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  body           String    @db.Text
  excerpt        String    @db.Text
  category       String
  tags           String[]  @default([])
  coverImageUrl  String?   @map("cover_image_url")
  author         String    @default("Admin")
  authorSub      String?   @map("author_sub")
  status         String    @default("draft")
  publishedAt    DateTime? @map("published_at")
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @db.Text @map("seo_description")
  ogImageUrl     String?   @map("og_image_url")
  viewCount      Int       @default(0) @map("view_count")
  readingTime    Int       @default(1) @map("reading_time")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([category])
  @@allow('read', status == "published" || auth().tier == pin || auth().tier == google)
  @@allow('create,update,delete', auth().tier == pin || auth().tier == google)
  @@map("blog_posts")
}

model Subscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  source       String   @default("footer")
  campaignData Json?    @map("campaign_data")
  status       String   @default("active")
  confirmToken String?  @map("confirm_token")
  isConfirmed  Boolean  @default(false) @map("is_confirmed")
  ipAddress    String?  @map("ip_address")
  tags         String[] @default([])
  unsubscribeToken String? @map("unsubscribe_token")
  unsubscribedAt   DateTime? @map("unsubscribed_at")
  frequency        String?   @default("weekly")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@allow('create', true)
  @@allow('read', auth().tier == pin || auth().tier == google)
  @@allow('update,delete', auth().tier == pin || auth().tier == google)
  @@map("subscribers")
}

model Lead {
  id           String   @id @default(cuid())
  type         String   @default("contact")
  name         String
  email        String
  phone        String?
  company      String?
  message      String   @db.Text
  sourceUrl    String?  @map("source_url")
  campaignData Json?    @map("campaign_data")
  status       String   @default("new")
  assignedTo   String?  @map("assigned_to")
  notes        String?  @db.Text
  convertedId  String?  @map("converted_id")
  convertedAt  DateTime? @map("converted_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([type])
  @@index([assignedTo])
  @@allow('create', true)
  @@allow('read', auth().tier == pin || auth().tier == google)
  @@allow('update,delete', auth().tier == pin || auth().tier == google)
  @@map("leads")
}

model Campaign {
  id           String    @id @default(cuid())
  name         String
  source       String?
  medium       String?
  term         String?
  content      String?
  startDate    DateTime?  @map("start_date")
  endDate      DateTime?  @map("end_date")
  budget       Int?
  status       String    @default("draft")
  conversions  Int       @default(0)
  clicks       Int       @default(0)
  impressions  Int       @default(0)
  metadata     Json      @default("{}")
  // Phase 10H marketing fields
  type         String?   @default("email")
  audience     String?   @default("all")
  subject      String?   @default("")
  body         String?   @db.Text
  scheduledAt  DateTime? @map("scheduled_at")
  abTest       Boolean   @default(false) @map("ab_test")
  startedAt    DateTime? @map("started_at")
  sentAt       DateTime? @map("sent_at")
  sentCount    Int       @default(0) @map("sent_count")
  failedCount  Int       @default(0) @map("failed_count")
  openedCount  Int       @default(0) @map("opened_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@allow('read', auth().tier == pin || auth().tier == google)
  @@allow('create,update,delete', auth().tier == pin || auth().tier == google)
  @@map("campaigns")
}

model AnalyticsEvent {
  id           String   @id @default(cuid())
  type         String
  pageUrl      String   @map("page_url")
  pagePath     String   @map("page_path")
  sessionId    String   @map("session_id")
  userSub      String?  @map("user_sub")
  referrer     String?
  campaignData Json?    @map("campaign_data")
  metadata     Json     @default("{}")
  country      String?
  device       String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@index([sessionId])
  @@index([pagePath])
  @@allow('create', true)
  @@allow('read', auth().tier == pin || auth().tier == google)
  @@map("analytics_events")
}

// ── Phase 10E: User Activity + AI Tasks (Wave 3 — added early for schema sync) ──

model UserActivity {
  id          String   @id @default(cuid())
  userSub     String   @map("user_sub")
  action      String
  description String   @db.Text
  resourceId  String?  @map("resource_id")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userSub, createdAt])
  @@allow('read', auth().sub == userSub || auth().tier == pin || auth().tier == google)
  @@allow('create', true)
  @@map("user_activity")
}

model UserTask {
  id          String    @id @default(cuid())
  userSub     String    @map("user_sub")
  name        String
  instruction String    @db.Text
  type        String    @default("one-time")
  schedule    String?
  trigger     String?
  aiAction    String    @default("custom") @map("ai_action")
  parameters  Json      @default("{}")
  status      String    @default("active")
  lastRunAt   DateTime? @map("last_run_at")
  nextRunAt   DateTime? @map("next_run_at")
  lastResult  String?   @db.Text @map("last_result")
  priority    String    @default("medium")
  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userSub, status])
  @@index([nextRunAt])
  @@allow('read', auth().sub == userSub)
  @@allow('create,update,delete', auth().sub == userSub)
  @@map("user_tasks")
}

// ── Phase 10I: AI Agent (Wave 4 — added early for schema sync) ──

model AiAgentConfig {
  id                          String   @id @default("default")
  enabled                     Boolean  @default(true)
  aiTier                      String   @default("pin") @map("ai_tier")
  enabledTools                Json     @default("[]") @map("enabled_tools")
  disabledTools               Json     @default("[]") @map("disabled_tools")
  allowDelete                 Boolean  @default(false) @map("allow_delete")
  allowEmailSend              Boolean  @default(false) @map("allow_email_send")
  allowBroadcast              Boolean  @default(false) @map("allow_broadcast")
  allowUserManagement         Boolean  @default(false) @map("allow_user_management")
  allowWhatsAppSend           Boolean  @default(false) @map("allow_whatsapp_send")
  allowWhatsAppGroup          Boolean  @default(false) @map("allow_whatsapp_group")
  allowWhatsAppBroadcast      Boolean  @default(false) @map("allow_whatsapp_broadcast")
  maxToolCallsPerConversation Int      @default(20) @map("max_tool_calls_per_conversation")
  maxToolCallsPerHour         Int      @default(100) @map("max_tool_calls_per_hour")
  requireConfirmation         Boolean  @default(true) @map("require_confirmation")
  readableModels              Json     @default("[]") @map("readable_models")
  writableModels              Json     @default("[]") @map("writable_models")
  customPrompt                String?  @db.Text @map("custom_prompt")
  tone                        String   @default("professional")
  model                       String?  @map("ai_model")
  webSearchEnabled            Boolean  @default(false) @map("web_search_enabled")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  @@allow('read', auth().tier == pin || auth().tier == google)
  @@allow('update', auth().tier == pin || auth().tier == google)
  @@map("ai_agent_config")
}

model AiActionLog {
  id              String    @id @default(cuid())
  userSub         String    @map("user_sub")
  conversationId  Int?      @map("conversation_id")
  prompt          String    @db.Text
  toolName        String    @map("tool_name")
  parameters      Json
  result          String    @default("success")
  resultData      Json      @default("{}") @map("result_data")
  error           String?   @db.Text
  policyCheck     String    @default("allowed") @map("policy_check")
  confirmedBy     String?   @map("confirmed_by")
  confirmedAt     DateTime? @map("confirmed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([userSub, createdAt])
  @@index([toolName])
  @@index([result])
  @@allow('read', auth().tier == pin || auth().tier == google)
  @@allow('create', true)
  @@map("ai_action_logs")
}

model AiToolPending {
  id              String    @id @default(cuid())
  userSub         String    @map("user_sub")
  conversationId  Int?      @map("conversation_id")
  toolName        String    @map("tool_name")
  parameters      Json
  explanation     String    @db.Text
  status          String    @default("pending")
  reviewedBy      String?   @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at")
  result          String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  expiresAt       DateTime  @default(now()) @map("expires_at")

  @@index([userSub, status])
  @@index([status, expiresAt])
  @@allow('read', auth().sub == userSub || auth().tier == pin || auth().tier == google)
  @@allow('update', auth().tier == pin || auth().tier == google)
  @@map("ai_tool_pending")
}

// ── Phase 10J: WhatsApp (Wave 5 — added early for schema sync) ──

model WhatsAppSession {
  id                  String   @id @default(cuid())
  label               String
  phoneNumber         String   @unique @map("phone_number")
  serverUrl           String   @map("server_url")
  sessionId           String   @unique @map("session_id")
  status              String   @default("qr_pending")
  qrCode              String?  @db.Text @map("qr_code")
  autoRespondEnabled  Boolean  @default(false) @map("auto_respond_enabled")
  aiPrompt            String?  @db.Text @map("ai_prompt")
  monitoredGroups     Json     @default("[]") @map("monitored_groups")
  autoReplyInGroups   Boolean  @default(false) @map("auto_reply_in_groups")
  webhookSecret       String   @map("webhook_secret")
  lastMessageAt       DateTime? @map("last_message_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@allow('read', auth().tier == pin || auth().tier == google)
  @@allow('create,update,delete', auth().tier == pin || auth().tier == google)
  @@map("whatsapp_sessions")
}

model WhatsAppMessage {
  id            String   @id @default(cuid())
  sessionId     String   @map("session_id")
  direction     String
  chatId        String   @map("chat_id")
  chatName      String?  @map("chat_name")
  isGroup       Boolean  @default(false) @map("is_group")
  senderPhone   String?  @map("sender_phone")
  senderName    String?  @map("sender_name")
  type          String   @default("text")
  body          String   @db.Text
  mediaUrl      String?  @map("media_url")
  mediaFilename String?  @map("media_filename")
  aiHandled     Boolean  @default(false) @map("ai_handled")
  aiResponse    String?  @db.Text @map("ai_response")
  isRead        Boolean  @default(false) @map("is_read")
  waMessageId   String?  @map("wa_message_id")
  aiActionLogId String?  @map("ai_action_log_id")
  status        String   @default("sent")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([sessionId, chatId, createdAt])
  @@index([direction, isRead])
  @@allow('read', auth().tier == pin || auth().tier == google)
  @@allow('create', true)
  @@map("whatsapp_messages")
}

model WhatsAppContact {
  id            String    @id @default(cuid())
  sessionId     String    @map("session_id")
  phoneNumber   String    @unique @map("phone_number")
  name          String?
  isBusiness    Boolean   @default(false) @map("is_business")
  tags          String[]  @default([])
  customerId    String?   @map("customer_id")
  lastMessageAt DateTime? @map("last_message_at")
  messageCount  Int       @default(0) @map("message_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([sessionId, tags])
  @@allow('read', auth().tier == pin || auth().tier == google)
  @@allow('create,update,delete', auth().tier == pin || auth().tier == google)
  @@map("whatsapp_contacts")
}

// ── Phase 10K: Integration Framework (Wave 5 — added early for schema sync) ──

model Integration {
  id              String    @id @default(cuid())
  type            String
  label           String
  status          String    @default("pending")
  authMethod      String    @default("api_key") @map("auth_method")
  secretKey       String?   @map("secret_key")
  oauthState      String?   @map("oauth_state")
  config          Json      @default("{}")
  aiToolsEnabled  Boolean   @default(true) @map("ai_tools_enabled")
  webhookUrl      String?   @map("webhook_url")
  webhookSecret   String?   @map("webhook_secret")
  lastSyncAt      DateTime? @map("last_sync_at")
  errorMessage    String?   @db.Text @map("error_message")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([type, status])
  @@allow('read', auth().tier == pin || auth().tier == google)
  @@allow('create,update,delete', auth().tier == pin || auth().tier == google)
  @@map("integrations")
}

model IntegrationSyncLog {
  id              String   @id @default(cuid())
  integrationId   String   @map("integration_id")
  syncType        String   @map("sync_type")
  status          String   @default("success")
  recordsProcessed Int     @default(0) @map("records_processed")
  recordsChanged  Int      @default(0) @map("records_changed")
  error           String?  @db.Text
  durationMs      Int      @map("duration_ms")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([integrationId, createdAt])
  @@allow('read', auth().tier == pin || auth().tier == google)
  @@allow('create', true)
  @@map("integration_sync_logs")
}

// ── Phase 10L: Credits & Billing (Wave 5 — added early for schema sync) ──

model CreditBalance {
  id                     String   @id @default("default")
  balance                Int      @default(50)
  freeCreditsUsed        Int      @default(0) @map("free_credits_used")
  freeCreditsLimit       Int      @default(50) @map("free_credits_limit")
  freeCreditsResetAt     DateTime @default(now()) @map("free_credits_reset_at")
  autoRechargeEnabled    Boolean  @default(false) @map("auto_recharge_enabled")
  autoRechargeThreshold  Int      @default(20) @map("auto_recharge_threshold")
  autoRechargePackId     String?  @map("auto_recharge_pack_id")
  totalPurchased         Int      @default(0) @map("total_purchased")
  totalUsed              Int      @default(0) @map("total_used")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@allow('read', auth().tier == pin || auth().tier == google)
  @@allow('update', auth().tier == pin || auth().tier == google)
  @@map("credit_balances")
}

model CreditTransaction {
  id              String   @id @default(cuid())
  type            String
  amount          Int
  balanceAfter    Int      @map("balance_after")
  description     String
  usageType       String?  @map("usage_type")
  conversationId  Int?     @map("conversation_id")
  paymentMethod   String?  @map("payment_method")
  paymentTxId     String?  @map("payment_tx_id")
  packId          String?  @map("pack_id")
  userSub         String?  @map("user_sub")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@index([userSub])
  @@allow('read', auth().tier == pin || auth().tier == google)
  @@allow('create', true)
  @@map("credit_transactions")
}

model CreditPack {
  id            String   @id @default(cuid())
  name          String
  credits       Int
  priceCents    Int      @map("price_cents")
  currency      String   @default("USD")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  bonusCredits  Int      @default(0) @map("bonus_credits")
  description   String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@allow('read', true)
  @@allow('create,update,delete', auth().tier == pin || auth().tier == google)
  @@map("credit_packs")
}

// ── Extended BlockType enum values (Phase 10G + 10H) ────────────
// Note: These are added as comments since the enum is already defined above.
// The codegen service will add these block types when generating tenant apps.
// New block types: product_catalog, product_detail, cart_drawer, checkout_form,
// booking_calendar, order_history, landing_hero, cta_section, newsletter_signup,
// blog_list, blog_detail, lead_form, social_share, social_feed, analytics_dashboard,
// video_player, image_gallery, notification_bell, user_profile, ai_task_config, content_page

// ── Additional models for marketing/email tracking ──

model CampaignAnalytics {
  id              String   @id @default(cuid())
  campaignId      String   @map("campaign_id")
  subscriberEmail String   @map("subscriber_email")
  sent            Boolean  @default(false)
  opened          Boolean  @default(false)
  clicked         Boolean  @default(false)
  converted       Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([campaignId])
  @@map("campaign_analytics")
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  template  String
  data      Json     @default("{}")
  status    String   @default("logged")
  messageId String?  @map("message_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([to])
  @@map("email_logs")
}
