+  const handleSortModelChange = useCallback((newSortModel: GridSortModel) => {
+    const limitedModel = newSortModel.slice(0, 3);
+    setSortModel(limitedModel);
+    console.log("[SheetViewerBlock] Sort model updated:", limitedModel);
+  }, []);
+
+  // Debounced cell update - waits 1 second after user stops typing before saving
+  const debouncedSaveCell = useCallback((params: UpdateSheetCellParams) => {
+    const key = `${params.sheet}-${params.rowIndex}-${params.column}`;
+
+    const existing = pendingUpdatesRef.current.get(key);
+    if (existing) clearTimeout(existing);
+
+    const timeoutId = setTimeout(async () => {
+      setIsSaving(true);
+      try {
+        await updateSheetCell(params).unwrap();
+        console.log(`[SheetViewerBlock] Saved debounced cell ${key} = ${params.value}`);
+      } catch (error) {
+        console.error(`Failed to update sheet cell ${key}:`, error);
+      } finally {
+        setIsSaving(false);
+        pendingUpdatesRef.current.delete(key);
+      }
+    }, 1000); // 1 second debounce
+
+    pendingUpdatesRef.current.set(key, timeoutId);
+  }, [updateSheetCell]);
+
+  const processRowUpdate = useCallback(
+    (newRow: GridRowModel, oldRow: GridRowModel): GridRowModel => {
+      const sheetName = sheet ?? '';
+      if (!sheetName) return oldRow;
+
+      let changedField: string | null = null;
+      let newValue: unknown = null;
+      for (const key in newRow) {
+        if (newRow[key as keyof typeof newRow] !== oldRow[key as keyof typeof oldRow] &&
+            !key.startsWith('_') && key !== 'id' && key !== '_rowIndex') {
+          changedField = key;
+          newValue = newRow[key as keyof typeof newRow];
+          break;
+        }
+      }
+
