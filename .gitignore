# TokenizMyApp — Root Config App Gitignore

# Dependencies
node_modules/

# Next.js
.next/
out/

# Build
dist/

# Env (local only — Vercel env vars are set via CLI/dashboard)
.env*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test
coverage/
test-results/

# Generated
src/generated/

# Vercel
.vercel/
.vercel

# Prisma generated (ZenStack output)
zenstack/src/generated/

# Next.js generated
next-env.d.ts

# Build info
tsconfig.tsbuildinfo
.env*

# Compiled .js route stubs (generated by manual SWC compile)
# These conflict with .tsx page files causing Turbopack hydration mismatches.
# Only API route .js files are intentionally kept for circular dependency workaround.
src/app/(app)/**/*.js
src/app/config/*.js
src/app/page.js
src/app/layout.js
src/app/not-found.js
